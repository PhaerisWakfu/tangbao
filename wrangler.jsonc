{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tangbao",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // HTML 不放在这里。这台 Windows 上的资源管线会把 .html 编成打不开的二进制。
    // 页面由 Worker 直接返回，样式和脚本仍走静态资源。
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangbao",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
