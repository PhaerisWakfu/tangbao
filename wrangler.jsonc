{
  // 本文件是本地开发与开源自建模板，绑定的是开发/迁移源库 tangbao261102，不是生产。
  // 生产部署与远程迁移一律显式指向 wrangler.production.jsonc（npm run deploy、npm run migrate:remote 已内置）。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tangbao",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // HTML 不放在这里。这台 Windows 上的资源管线会把 .html 编成打不开的二进制。
    // 页面由 Worker 直接返回，样式和脚本仍走静态资源。
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      // 部署到自己的账号时换成自己的 KV namespace ID。
      "id": "3b9ad11ebb4f4812b93c04b3e9e86e3a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // 部署到自己的账号时换成自己的 D1 database ID。
      "database_name": "tangbao261102",
      "database_id": "40a8c0a3-0aef-473f-9708-6ef90a2f40c0",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mail.phaeris.cn"]
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://tangbao.phaeris.cn",
    "MAIL_MODE": "cloudflare",
    "MAIL_FROM": "糖包 <noreply@mail.phaeris.cn>",
    "MAIL_DAILY_LIMIT": "200"
  },
  "triggers": {
    // 邮件已持久化后立即尝试；分钟任务补偿已知可重试的限流失败。
    "crons": ["* * * * *"]
  }
}
