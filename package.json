{
  "name": "tangbao",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhaerisWakfu/tangbao.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "local:prepare": "node scripts/local-sandbox.mjs prepare",
    "local:dev": "node scripts/local-sandbox.mjs dev",
    "local:seed": "node scripts/local-sandbox.mjs seed",
    "local:verify": "node scripts/local-sandbox.mjs verify",
    "local:info": "node scripts/local-sandbox.mjs info",
    "local:clone": "node scripts/local-sandbox.mjs clone",
    "local:legacy:prepare": "node scripts/local-legacy.mjs prepare",
    "local:legacy:dev": "node scripts/local-legacy.mjs dev",
    "local:legacy:info": "node scripts/local-legacy.mjs info",
    "local:legacy:backup": "node scripts/local-legacy.mjs backup",
    "design": "node scripts/design-server.mjs",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "types": "wrangler types",
    "check": "node scripts/check-client.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "migrate:turso": "node scripts/migrate-turso.mjs",
    "browser:local": "node scripts/browser.mjs",
    "shoot:local": "node scripts/shoot-site.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "sensitive-word-tool": "^1.1.10"
  }
}
